thread.h:

  #define FD_MAX 128
    Size of each process's file descriptor table.

  struct thread (inside #ifdef USERPROG), new members:
    struct list child_list;         /* children we exec'ed */
    struct child_info *child_self;  /* our own record, seen by parent */
    int exit_status;                /* value passed to exit(), or -1 */
    struct fd_entry *fd_table[FD_MAX];
    struct file *exec_file;         /* our executable, kept open */
  child_list/child_self implement wait and exec. fd_table holds the
  open files. exec_file keeps writes to our own binary denied.

  struct child_info {
    tid_t tid;
    int exit_status;
    struct semaphore wait_sema;     /* upped when the child exits */
    struct semaphore load_sema;     /* upped when loading is done */
    bool is_exited;
    bool is_orphan;                 /* parent is gone */
    struct list_elem child_elem;
    bool load_success;
  };
  One record per child, allocated with malloc, shared by parent and
  child so either can outlive the other.

syscall.c:

  struct lock filesys_lock;
    Serializes all calls into filesys/. Also used by load() and
    process_exit().

  enum fd_type { FD_FILE, FD_PIPE_R, FD_PIPE_W };
  struct fd_entry { enum fd_type type; struct file *file;
                    struct pipe *pipe; };
    What an fd slot points to, so read/write/close can tell a file
    from a pipe end.

